{
    "name": "janalis/porta-phpstan",
    "description": "PHPStan analysis of the current file, or on save, as diagnostics",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5"
    },
    "extra": {
        "porta": {
            "tools": [
                {
                    "name": "phpstan",
                    "purpose": "the analyser",
                    "setting": "binary",
                    "sources": [
                        [
                            "composer",
                            "phpstan/phpstan"
                        ]
                    ]
                }
            ]
        }
    }
}
